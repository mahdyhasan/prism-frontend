# ── PRISM environment variables ──────────────────────────────────────────────
# Copy to .env and fill in real values. Never commit .env.

PRISM_ENV=dev                         # dev | staging | prod

# Database (MySQL 8.0)
PRISM_DATABASE_URL=mysql+aiomysql://prism:prism@localhost:3306/prism

# Redis
PRISM_REDIS_URL=redis://localhost:6379/0

# Security
# Generate with: python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
PRISM_TOKEN_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_BASE64
PRISM_JWT_SECRET=CHANGE_ME_JWT_SECRET

# Google OAuth (create at console.cloud.google.com)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# NextAuth uses these same credentials (must match GOOGLE_OAUTH_CLIENT_ID/SECRET)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Service Account (path to JSON file or inline JSON as single line)
GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/service-account.json

# Anthropic
ANTHROPIC_API_KEY=

# Service URLs
PRISM_API_BASE_URL=http://localhost:8000
PRISM_WEB_BASE_URL=http://localhost:3000

# Observability (optional)
SENTRY_DSN=

# Next.js (must be prefixed NEXT_PUBLIC_ to expose to browser)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=CHANGE_ME_NEXTAUTH_SECRET
